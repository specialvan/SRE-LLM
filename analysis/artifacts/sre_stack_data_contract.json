{
  "event_stage_routes": {
    "CanaryScheduler": "plan",
    "PredictiveAutoscaler": "plan",
    "SLOGuardrail": "guard",
    "SignalFusion": "observe",
    "StabilityGuard": "stability",
    "WeightedLoadBalancer": "allocate"
  },
  "evidence_scope": "research_stack_data_contract",
  "orchestration_model": "single_process_research_loop",
  "production_claim": false,
  "split_ready_boundaries": [
    "observe_to_plan",
    "plan_to_guard",
    "guard_to_allocate",
    "allocate_to_execute"
  ],
  "stages": [
    {
      "event_kinds": [
        "missing_sensor",
        "outlier_rejected",
        "adapter_exception"
      ],
      "fallback_modes": [
        "substitute_observed_rps"
      ],
      "inputs": [
        "dt",
        "sensor_readings"
      ],
      "outputs": [
        "state",
        "observed_rps",
        "runtime.events"
      ],
      "producer": "SignalFusion.step",
      "stage": "observe"
    },
    {
      "event_kinds": [
        "stability_violation",
        "adapter_exception"
      ],
      "fallback_modes": [
        "skip_optional_stage"
      ],
      "inputs": [
        "state",
        "tick_time"
      ],
      "outputs": [
        "stability",
        "runtime.events"
      ],
      "producer": "StabilityGuard.step",
      "stage": "stability"
    },
    {
      "event_kinds": [
        "replica_bound_active",
        "rollout_rejected",
        "adapter_exception"
      ],
      "fallback_modes": [
        "keep_current_value",
        "skip_optional_stage"
      ],
      "inputs": [
        "observed_rps",
        "forecast_rps",
        "current_replicas"
      ],
      "outputs": [
        "replicas_next",
        "canary",
        "runtime.events"
      ],
      "producer": "PredictiveAutoscaler.step/CanaryScheduler",
      "stage": "plan"
    },
    {
      "event_kinds": [
        "unsafe_proposal_projected",
        "adapter_exception"
      ],
      "fallback_modes": [
        "zero_action"
      ],
      "inputs": [
        "nn_proposal"
      ],
      "outputs": [
        "guardrail",
        "safe_action",
        "runtime.events"
      ],
      "producer": "SLOGuardrail.audit",
      "stage": "guard"
    },
    {
      "event_kinds": [
        "bounded_ls_residual",
        "adapter_exception"
      ],
      "fallback_modes": [
        "reuse_last_good_cache",
        "zero_action"
      ],
      "inputs": [
        "safe_action",
        "zone_target"
      ],
      "outputs": [
        "alloc_shares",
        "alloc_info",
        "runtime.events"
      ],
      "producer": "WeightedLoadBalancer.allocate",
      "stage": "allocate"
    },
    {
      "event_kinds": [],
      "fallback_modes": [],
      "inputs": [
        "state",
        "stability",
        "replicas_next",
        "guardrail",
        "alloc_info"
      ],
      "outputs": [
        "runtime.states",
        "runtime.events",
        "runtime.degraded"
      ],
      "producer": "SREControlStack.step",
      "stage": "execute"
    }
  ]
}
